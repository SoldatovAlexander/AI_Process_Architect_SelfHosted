{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-process-architect.local/schemas/entitlement-catalog-v1.schema.json",
  "title": "AI Process Architect entitlement catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "entitlements", "plans"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "catalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "entitlements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,79}$"},
          "kind": {"enum": ["boolean", "integer"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "audience", "name", "entitlements"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
          "audience": {"enum": ["hosted", "self_hosted", "internal"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "entitlements": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"oneOf": [{"type": "boolean"}, {"type": "integer", "minimum": -1}]}
          }
        }
      }
    }
  }
}
