# Copy to .env.compose for a customer-operated installation. Do not commit the resulting file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET_KEY=replace-with-a-long-random-secret
LLM_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-stable-32-byte-base64url-key
DEPLOYMENT_PROFILE=default
SELF_HOSTED_DEFAULT_PLAN_ID=read_only
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173

# Optional online activation. Offline activation works without these values.
LICENSE_SERVER_URL=https://licenses.example.example
LICENSE_REQUEST_EMAIL=licenses@example.com
LICENSE_SERVER_TOKEN=replace-with-the-activation-token
LICENSE_TRUSTED_KEYS_PATH=/app/config/licensing/trusted-public-keys.json
LICENSE_REVOCATIONS_PATH=/app/config/licensing/revocations.json
