[Unit]
Description=AI Process Architect Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/alex/ai-process-architect
ExecStart=/usr/bin/docker compose --env-file .env.compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env.compose stop
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
