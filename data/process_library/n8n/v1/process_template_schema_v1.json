{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Process Template",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "version",
    "source",
    "graph",
    "adapter_slots",
    "quality"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "provenance"
      ],
      "properties": {
        "kind": {
          "enum": [
            "n8n",
            "manual",
            "bpmn",
            "other"
          ]
        },
        "provenance": {
          "type": "object"
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "semantic_type",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "semantic_type": {
                "enum": [
                  "start_event",
                  "end_event",
                  "service_task",
                  "user_task",
                  "business_rule_task",
                  "script_task",
                  "send_task",
                  "receive_task",
                  "exclusive_gateway",
                  "parallel_gateway",
                  "inclusive_gateway",
                  "timer_event",
                  "message_event",
                  "subprocess",
                  "data_store",
                  "error_boundary"
                ]
              },
              "name": {
                "type": "string"
              },
              "adapter_role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "condition": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "adapter_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "required"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "confidence",
        "review_status"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_status": {
          "enum": [
            "draft",
            "needs_review",
            "approved",
            "rejected"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}