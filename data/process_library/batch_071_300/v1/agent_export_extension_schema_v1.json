{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Agent Bundle Process Extension",
  "type": "object",
  "required": [
    "enabled"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "topology": {
      "enum": [
        "single_tool_agent",
        "planner_executor",
        "supervisor_worker",
        "multi_agent_team",
        "event_driven_agent",
        "human_governed_agent"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_bundle": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_protocol": {
      "type": "string"
    },
    "approval_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sandbox_policy": {
      "type": "string"
    },
    "evaluation": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "topology",
          "roles",
          "required_bundle",
          "memory",
          "handoff_protocol",
          "approval_points",
          "stop_conditions",
          "sandbox_policy",
          "evaluation"
        ]
      }
    }
  ]
}